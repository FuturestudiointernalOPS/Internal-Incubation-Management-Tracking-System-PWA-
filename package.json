{
  "name": "impact-os",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "i18n:parity": "node scripts/i18n-parity.mjs",
    "db:align": "node scripts/db-audit/apply-align-migration.mjs",
    "verify:alignment": "node scripts/verify-feature-alignment.mjs",
    "sync-finance": "node scripts/sync-finance.js --syncAll"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^uuid$": "<rootDir>/src/__tests__/__mocks__/uuid.js",
      "^lucide-react$": "<rootDir>/node_modules/lucide-react/dist/cjs/lucide-react.js"
    },
    "transform": {
      "^.+\\.jsx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            [
              "@babel/preset-react",
              {
                "runtime": "automatic"
              }
            ]
          ]
        }
      ]
    },
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.48.1",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "framer-motion": "^12.0.0",
    "googleapis": "^171.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.11",
    "lucide-react": "^0.473.0",
    "next": "^16.2.9",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "unpdf": "^0.12.2",
    "uuid": "^13.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "autoprefixer": "^10.4.27",
    "babel-jest": "^30.4.1",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.2.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19"
  }
}
