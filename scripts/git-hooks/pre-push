#!/bin/sh
# Local half of the branch guard. See docs/BRANCH_PROTECTION.md.
#
# Refuses:
#   - any push to main that is not a commit reachable from the local G branch;
#   - any push to interns that introduces white-label work main has not
#     published yet.
#
# White-label history already reachable from origin/main is exempt: those
# branches were merged into main and reverted there, so every branch built on
# main carries them. Only work main has not shipped is refused.
#
# Install it with: sh scripts/git-hooks/install.sh

set -eu

zero="0000000000000000000000000000000000000000"

block() {
  printf '\npre-push: %s\n' "$1" >&2
  printf 'pre-push: push refused. See docs/BRANCH_PROTECTION.md.\n\n' >&2
  exit 1
}

resolve_ref() {
  for candidate in "$@"; do
    if git show-ref --verify --quiet "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

g_ref="$(resolve_ref refs/heads/G refs/remotes/origin/G || true)"
# The published main wins over a local main: only history main has actually
# shipped may exempt white-label commits.
main_ref="$(resolve_ref refs/remotes/origin/main refs/heads/main || true)"

white_refs=""
for candidate in refs/heads/white_label_os refs/remotes/origin/white_label_os; do
  if git show-ref --verify --quiet "$candidate"; then
    white_refs="${white_refs}${candidate}
"
  fi
done

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion: the server decides.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ -z "$g_ref" ]; then
      block "main only receives G, but no local G branch exists. Fetch it first: git fetch origin G:G"
    fi
    if ! git merge-base --is-ancestor "$local_sha" "$g_ref"; then
      block "main only receives G. The pushed commit is not reachable from $g_ref."
    fi
  fi

  if [ "$remote_ref" = "refs/heads/interns" ] && [ -n "$white_refs" ]; then
    for white_ref in $white_refs; do
      git merge-base --is-ancestor "$white_ref" "$local_sha" || continue
      # Already published by main: tolerated.
      if [ -n "$main_ref" ] && git merge-base --is-ancestor "$white_ref" "$main_ref"; then
        continue
      fi
      block "$white_ref is an ancestor of the history being pushed to interns, and main does not carry it yet. Only white-label history already published in main may travel to interns."
    done
  fi
done
