# ═════════════════════════════════════════════════════════════════════════════
# IMPACTOS — VARIABLES D'ENVIRONNEMENT (MODÈLE, AUCUNE VALEUR)
#
# Copiez ce fichier en `.env.local`, remplissez les valeurs, redémarrez.
# `.env.local` n'est jamais versionné ; ce modèle-ci, oui.
#
# Règle à retenir : tout nom qui commence par NEXT_PUBLIC_ est RECOPIÉ dans le
# code envoyé au navigateur. N'y mettez donc JAMAIS un secret (clé privée, clé
# secrète, mot de passe, jeton, clé de service).
# ═════════════════════════════════════════════════════════════════════════════

# ─── Base de données & stockage (obligatoire) ───────────────────────────────
# Chaîne de connexion PostgreSQL de l'hébergeur de la base.
DATABASE_URL=
# Projet Supabase, utilisé pour le stockage de fichiers. URL + clé anonyme :
# publiques par nature (elles ne donnent accès qu'aux fichiers autorisés).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service Supabase. SECRÈTE — serveur uniquement, ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Adresse de l'application ───────────────────────────────────────────────
# Base des liens absolus placés dans les e-mails (activation, reçu, mot de passe).
# En production, exemple : https://impactos.futurestudio.bj
# Sur Vercel sans valeur explicite, l'adresse automatique du déploiement est utilisée.
APP_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_URL=

# ─── E-mails transactionnels ────────────────────────────────────────────────
# Deux canaux sont possibles et le transport bascule tout seul sur l'autre quand
# l'un n'est pas configuré. Canal principal : Google Workspace (boîte pro).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=
# Canal de repli : service d'e-mail transactionnel.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Secret du webhook Resend (suivi des envois : remis, ouvert, rejeté…).
RESEND_WEBHOOK_SECRET=
# Canal préféré : "gmail" ou "resend". Vide = choix automatique.
EMAIL_PRIMARY_PROVIDER=
# Canal des e-mails de décision (mêmes valeurs possibles).
DECISION_EMAIL_PROVIDER=

# ─── Paiement en ligne des cours (Kkiapay) ──────────────────────────────────
# Guide complet : docs/CHECKOUT_KKIAPAY.md
# Tant que ces valeurs sont vides, l'application REFUSE d'accorder un accès au
# cours : elle ne devine jamais qu'un paiement a réussi.
#
# Clé PUBLIQUE du compte marchand (Développeurs → Clés API). C'est la seule des
# trois clés qui peut être vue par un visiteur.
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
# Clé PRIVÉE du compte marchand (même écran). Serveur uniquement.
KKIAPAY_PRIVATE_KEY=
# Clé SECRÈTE D'API (même écran). Serveur uniquement.
KKIAPAY_SECRET_KEY=
# SECRET DU WEBHOOK — à ne pas confondre avec la clé secrète d'API : il se définit
# à côté du webhook, et c'est lui que Kkiapay place dans x-kkiapay-secret.
KKIAPAY_WEBHOOK_SECRET=
# true = mode test, false = mode réel.
KKIAPAY_SANDBOX=
# Durée (minutes) pendant laquelle l'onglet du payeur peut encore recevoir son
# lien d'accès juste après avoir payé. Défaut : 15.
CHECKOUT_ACCESS_WINDOW_MINUTES=
# Prestataire actif. Défaut : kkiapay.
PAYMENT_PROVIDER=
# Devise par défaut. Défaut : XOF. Un cours peut définir la sienne.
PAYMENT_CURRENCY=
# Unité du montant : major (prix tel quel) ou minor (×100, devises à centimes).
# Défaut : major. Un cours peut définir la sienne.
PAYMENT_AMOUNT_UNIT=
# Nombre explicite, seulement si ni major ni minor ne convient. Laisser commenté.
# PAYMENT_AMOUNT_MULTIPLIER=

# ─── Points d'entrée planifiés ──────────────────────────────────────────────
# Ces secrets protègent les adresses appelées par les tâches planifiées.
CRON_SECRET=
REMINDERS_SECRET_KEY=
OVERDUE_SECRET_KEY=

# ─── Intégrations facultatives ──────────────────────────────────────────────
# IA : évaluation des candidatures, personnalisation des e-mails.
DEEPSEEK_API_KEY=
# Vidéos de cours : métadonnées et durée des vidéos YouTube.
YOUTUBE_DATA_API_KEY=
# Calendrier des séances.
CALENDAR_PROVIDER=
GOOGLE_CALENDAR_ID=
CALENDAR_USER_EMAIL=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Notion : espaces de travail de projet.
NOTION_API_KEY=
NOTION_PROJECTS_DATABASE_ID=
NOTION_TASKS_DATABASE_ID=

# ─── Identité, sécurité et réglages internes ────────────────────────────────
# Clé de signature des jetons d'accès contextuels (autorisations).
CONTEXT_GRANTS_SECRET_KEY=
# Usurpation d'identité par un super administrateur (désactivée par défaut).
ALLOW_IMPERSONATION=
NEXT_PUBLIC_ALLOW_IMPERSONATION=
# Portée stricte sur les espaces venture.
AUTHZ_VENTURE_STRICT=
# Repli hérité pour les participants (à laisser désactivé).
DISABLE_LEGACY_PARTICIPANT_FALLBACK=
# Rattrapage interne des tâches.
ALLOW_TASK_BACKFILL=
# Délai de cache des accès venture, en millisecondes.
VENTURE_ACCESS_CACHE_TTL_MS=
# Version affichée (informatif).
NEXT_PUBLIC_APP_VERSION=
